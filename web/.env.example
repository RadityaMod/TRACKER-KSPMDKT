# ---------------------------------------------------------------------------
# Google Sheets sebagai sumber data.
#
# Salin file ini jadi .env.local lalu isi. Kalau DIBIARKAN KOSONG, aplikasi
# otomatis memakai data/laporan.csv — jadi aman dijalankan tanpa kredensial.
#
# File ini IKUT TER-COMMIT. Jangan pernah menaruh ID sheet asli, kunci, atau
# apa pun yang menunjuk ke data sungguhan di sini — cukup placeholder.
# .env.local sendiri sudah masuk .gitignore.
# ---------------------------------------------------------------------------

# ID spreadsheet — bagian di antara /d/ dan /edit pada URL Google Sheets:
# https://docs.google.com/spreadsheets/d/<INI_ID_NYA>/edit
SHEET_ID=

# Nama tab dan rentang kolom. Sheet ini punya 14 kolom (A sampai N).
# Nama tab yang mengandung spasi harus dibungkus kutip tunggal DI DALAM
# kutip ganda, contoh:
#   SHEET_RANGE="'Tracker Pelapor KSP Mendekat'!A:N"
SHEET_RANGE=Sheet1!A:N

# Isi file kunci JSON service account, DALAM SATU BARIS, dibungkus kutip tunggal.
# Ambil dari: GCP Console > IAM & Admin > Service Accounts > Keys > Add Key > JSON
# Lalu bagikan sheet ke client_email tersebut sebagai Viewer.
#
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"nama@project.iam.gserviceaccount.com",...}'
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---------------------------------------------------------------------------
# Opsional: sajikan snapshot data/laporan.csv bila Google Sheets gagal dibaca.
#
# Default-nya MATI. Kalau dinyalakan, halaman menampilkan banner merah berisi
# alasan kegagalan — snapshot lokal beku, jadi datanya bisa usang tanpa ada
# yang menyadari kalau tidak diperingatkan.
# ---------------------------------------------------------------------------
ALLOW_LOCAL_FALLBACK=false
# ---------------------------------------------------------------------------
# PIN gate dashboard.
#
# Isi di Vercel Production Environment Variables, bukan di file ini.
# Satu PIN bisa dipakai banyak perangkat. DASHBOARD_PIN_SECRET opsional;
# bila dikosongkan, session cookie otomatis ditandatangani memakai PIN.
# ---------------------------------------------------------------------------
DASHBOARD_PIN=
DASHBOARD_PIN_SECRET=
